{
  "objectName" : "ct_alta_stellarium",
  // "colonyTags" : [ "crafting", "science" ],
  "category" : "crafting",
  "level" : 6, "race" : "alta",

  "shortdescription" : "^orange;Alta Stellarium^reset;",
  "description" : "An ^#b0e0fc;alta^reset; cosmic research station for working with ^#60c0fc;stardust^reset;, stellar components, and void phenomena.",
  "longdescription" : "The Alta Stellarium is a tier 6 advanced stellar research facility dedicated to studying and manipulating cosmic energies. This specialized station works with ^#60c0fc;stardust^reset; - the primordial energy that created altas themselves - as well as ^#2080f0;ceternia^reset;, ^#2080f0;alternia^reset;, and ^#60c0fc;enternia^reset; energies. It produces stellar analysis tools, processes cosmic materials into usable components, and can even work with dangerous ^shadow^void^reset; phenomena. The Stellarium represents the pinnacle of alta understanding of the universe's fundamental energies, including research into ^#60c0fc;poi^reset; elementals and other stellar beings.",
  "altaDescription" : "The stellar research station! This is where we work with stardust itself - the energy our creators used to make us. It's both humbling and amazing~",

  "apexDescription" : "Alta cosmic energy research. Their understanding of stellar phenomena is beyond our current science.",
  "avianDescription" : "A station for studying the stars and cosmic energies! The heavens' mysteries unveiled.",
  "floranDescription" : "Studiesss star magic. Very bright, very powerful. Floran carefulsss around thisss.",
  "glitchDescription" : "Awed. This station works with fundamental cosmic energies. The scope is staggering.",
  "humanDescription" : "Cosmic energy lab! Stardust, void stuff, stellar components - heavy sci-fi territory here.",
  "hylotlDescription" : "A profound station dedicated to understanding the cosmos. The alta seek to comprehend their own origins.",
  "novakidDescription" : "I hear this station works with stardust and cosmic stuff - makes sense why they'd be interested in novakids!",

  "inventoryIcon" : "icon.png",
  "orientations" : [
    { "dualImage" : "body.png", "spaceScan" : 0.1, "anchors" : [ "bottom" ], "collision" : "platform" }
  ],

  "interactAction" : "OpenCraftingInterface",
