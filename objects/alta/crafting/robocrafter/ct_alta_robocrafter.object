  "category" : "crafting",
  "level" : 6, "race" : "alta",

  "shortdescription" : "^orange;Alta Robocrafter^reset;",
  "description" : "An ^#b0e0fc;alta^reset; robotics assembly station for creating ^#60c0fc;drones^reset;, ^#60c0fc;droids^reset;, ^#60c0fc;androids^reset;, and AI helpers.",
  "longdescription" : "The Alta Robocrafter is a tier 6 advanced robotics fabrication station specializing in artificial intelligence and mechanical companions. This sophisticated workshop creates everything from simple ^#60c0fc;security drones^reset; to complex ^#60c0fc;android helpers^reset;. The station includes AI core programming suites, neural network calibration tools, and precision robotic assembly equipment. It's the heart of alta robotics research, producing the mechanical companions that assist altas in daily tasks, security, exploration, and companionship.",
  "altaDescription" : "My robot workshop! I can build all kinds of helpful companions here - drones, droids, and even advanced androids with AI personalities!~",

  "apexDescription" : "Alta robotics assembly station. Their AI technology is surprisingly sophisticated.",
  "avianDescription" : "A workshop for building robot companions! The alta create such helpful machines.",
  "floranDescription" : "Makesss metal friendsss. Floran not trussst them like plantss but they work good.",
  "glitchDescription" : "Fascinated. As a robotic being myself, I find alta AI development methodology quite intriguing.",
  "humanDescription" : "Robot building station! From security drones to android buddies. Pretty cool tech.",
  "hylotlDescription" : "An elegant synthesis of engineering and artificial consciousness. The alta honor their creations.",
  "novakidDescription" : "Robot makin' station! All sorts of helpful mechanical critters and companions.",

  "inventoryIcon" : "icon.png",
  "orientations" : [
    { "dualImage" : "body.png", "spaceScan" : 0.1, "anchors" : [ "bottom" ], "collision" : "platform" }
  ],

