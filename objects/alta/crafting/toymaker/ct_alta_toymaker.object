{
  "objectName" : "ct_alta_toymaker",
  "colonyTags" : [ "crafting", "party" ],
  "category" : "crafting",
  "level" : 5, "race" : "alta",

  "shortdescription" : "^orange;Alta Toymaker^reset;",
  "description" : "An alta crafting station for creating toys and entertainment items.",
  "longdescription" : "The Alta Toymaker is a tier 5 crafting station dedicated to producing toys, games, and entertainment items for alta leisure culture. This station creates everything from toy weapons like water blasters and bubble guns to plushies, fireworks, arcade machines, and collectible figurines. Alta society values play and entertainment as essential to well-being, making the Toymaker an important part of recreational technology. The station features specialized equipment for safe toy assembly, including soft material processors, harmless projectile calibrators, and electronic game component assembly tools.",
  "altaDescription" : "The toy station! I love making fun things here~ From water guns to plushies to arcade machines, it's all about having a good time!",

  "apexDescription" : "Alta toy manufacturing station. The safety features for toy weapons are impressively engineered.",
  "avianDescription" : "A station for making toys and games! Altas really value their playtime and entertainment.",
  "floranDescription" : "Floran like colorful toy maker! Makesss fun thingsss to play with!",
  "glitchDescription" : "Delighted. This crafting station demonstrates that altas prioritize joy and play in their society.",
  "humanDescription" : "Alta toy factory! Water guns, fireworks, arcade games - they've got the fun covered!",
  "hylotlDescription" : "A beautiful synthesis of recreation and craftsmanship. The dedication to safe, quality entertainment is admirable.",
  "novakidDescription" : "Toy-makin' station! All sorts of fun gadgets and games. Altas sure know how to have a good time!",

  "inventoryIcon" : "icon.png",
  "orientations" : [
    { "dualImage" : "body.png", "spaceScan" : 0.1, "anchors" : [ "bottom" ], "collision" : "platform" }
  ],

