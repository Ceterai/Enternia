  "category" : "crafting",
  "level" : 6, "race" : "alta",

  "shortdescription" : "^orange;Alta Architect Station^reset;",
  "description" : "An ^#b0e0fc;alta^reset; heavy engineering station for constructing ^#60c0fc;vehicles^reset;, ^#60c0fc;mechs^reset;, and large-scale machinery.",
  "longdescription" : "The Alta Architect Station is a tier 6 advanced heavy engineering workshop designed for fabricating extra-large devices and machinery. This massive station produces ^#60c0fc;vehicles^reset; like hovercrafts and exploratory rovers, ^#60c0fc;mechs^reset; for combat and construction, ^#60c0fc;terraformers^reset; for planetary modification, and ^#60c0fc;microformers^reset; for biome manipulation. It features heavy-duty assembly equipment, large-scale welding systems, and advanced CAD holographic design interfaces. The station represents the pinnacle of alta industrial engineering, capable of producing machinery far too large for standard crafting stations.",
  "altaDescription" : "The big machinery workshop! This is where we build vehicles, mechs, and massive terraforming equipment. It's like the workshop but for REALLY big projects!~",

  "apexDescription" : "Alta heavy engineering capabilities. Their vehicle and mech technology rivals our own.",
  "avianDescription" : "A workshop for building grand machines! Vehicles that soar and mechs that march.",
  "floranDescription" : "Makesss big metal thingsss. Big vechilesss, big robotsss. Floran impresssed.",
  "glitchDescription" : "Impressed. This station's scale and engineering precision are remarkable achievements.",
  "humanDescription" : "Heavy machinery workshop! Mechs, vehicles, terraformers - the big stuff.",
  "hylotlDescription" : "Engineering on a grand scale. The alta balance ambition with careful craftsmanship.",
  "novakidDescription" : "Big machine builder! Rovers, mechs, all kinds of heavy equipment and vehicles.",

  "inventoryIcon" : "icon.png",
  "orientations" : [
    { "dualImage" : "body.png", "spaceScan" : 0.1, "anchors" : [ "bottom" ], "collision" : "platform" }
