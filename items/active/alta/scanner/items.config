    "alienweirdwood" : { "level" : 1,
      "alkey" : "sofarakut",
      "longdescription" : "This type of wood can often be found in botanically diverse environments, for example on mutated planets.",
      "altaDescription" : "So bright! Looks pretty similar to unona wood."
    },
    "rainbowwood" : { "level" : 2,
      "alkey" : "spectrokut",
      "longdescription" : "Even though it doesn't naturally grow in most alta habitats, due to its beauty it became very popular with them, making alta imports of this wood type into quite a business.",
      "altaDescription" : "So pretty!"
    },
    "alienwoodsap" : {
      "alkey" : "nurokunur",
      "longdescription" : "This generic sap is a mixture of quite a number of biofootprints.",
      "altaDescription" : "So similar to ionic ferment, except less... ionic?"
    },
    "paper" : { "level" : 0,
      "alkey" : "kog",
      "longdescription" : "In alta culture, most paper is made from ^#3587ff;ayaka wood^reset;. Even then, it's rarely used in favor of long-lasting multi-use electronic devices, like ebooks, laptops and datamasses.",
      "altaDescription" : "Ah, the documentation, the posters, and how you shouldn't eradicate plants just because you can. Looking at you, humans."
    },
    "reed" : {
      "alkey" : "iwa",
      "longdescription" : "Reeds are versatile materials in alta culture, used for everything from decorative blocks to paper production, though less common than ^#3587ff;ayaka wood^reset;.",
      "altaDescription" : "I love the texture of reed blocks! They make rooms feel so natural."
    },

