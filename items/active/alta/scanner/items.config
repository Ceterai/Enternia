    // SALVAGE & MECHANICAL PARTS
    // ═══════════════════════════════════════════════════════════════════════════
    "salvagearm" : {
      "longdescription" : "Salvaged robotic arm components from damaged mechs. Alta engineers study these mechanical parts to understand alien mech construction methods.",
      "altaDescription" : "Mech arm parts! Useful for repairs or studying alien robotics design~"
    },
    "salvagebody" : {
      "longdescription" : "Salvaged mech body components containing valuable materials and technology. Altas appreciate the resourcefulness of salvaging and recycling advanced technology.",
      "altaDescription" : "Mech body salvage! Waste not, want not - recycling tech is always smart."
    },
    "salvagebooster" : {
