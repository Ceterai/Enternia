    "copperore" : { "level" : 1,
      "longdescription" : "An alien metal ore not found on ^#20f080;alterash^reset; planets. Altas learned about copper from other species, though they historically relied on crystals and titanium instead.",
      "altaDescription" : "Alien metal ore! I've heard it's useful for basic crafting."
    },
    "copperbar" : { "level" : 1,
      "longdescription" : "Copper bars are common at shallow depths on non-alterash worlds. Altas sometimes import copper for specific applications, though it's not part of traditional alta metallurgy.",
      "altaDescription" : "Nice warm color! Though it oxidizes... Why not use altan or crystals instead?"
    },
    "ironore" : { "level" : 2,
      "longdescription" : "Iron ore is a fundamental crafting material across the rest of the universe. Altas recognize its importance for most species, though they don't use it themselves.",
      "altaDescription" : "Standard iron ore. Does the job, but nothing special compared to what we have!"
    },
    "ironbar" : { "level" : 2,
      "longdescription" : "Iron bars are fundamental to many civilizations' development. Altas find it interesting that other species built their early technology on iron, while altas used titanium and altan from the start.",
      "altaDescription" : "Other species' basic metal! We were lucky to have titanium naturally on our planets."
    },
    "goldore" : { "level" : 2,
      "longdescription" : "Gold ore is valued by many species for its rarity and beauty. Altas don't mine gold naturally, but import it for specialized electronics when crystal-based alternatives aren't suitable.",
      "altaDescription" : "Shiny alien metal! Good for conductivity, but we usually just use our own materials."
    },
    "goldbar" : { "level" : 2,
      "longdescription" : "Gold bars from alien worlds are occasionally used in alta research facilities. While not part of traditional alta technology, gold serves specific roles in imported equipment designs.",
      "altaDescription" : "Pretty conductive metal! Sometimes our scientists import this for special projects."
    },
    "silverore" : { "level" : 2,
      "longdescription" : "Silver ore doesn't occur on alterash planets. Altas studying alien metallurgy note its thermal and electrical properties, though these overlap with materials altas already use.",
      "altaDescription" : "Another alien metal! Shiny, but we have plenty of better materials on alterash already."
    },
    "tungstenore" : { "level" : 3,
      "longdescription" : "Tungsten ore is an alien material with extreme heat resistance. Altas rarely need tungsten since their composite materials and phospholion-based technology handle high temperatures differently.",
      "altaDescription" : "Very heavy alien ore! I wonder what it's like to have this naturally on your planet?"
    },
    "tungstenbar" : { "level" : 3,
      "longdescription" : "Tungsten bars from alien worlds are dense and heat-resistant. Alta engineers study tungsten but prefer their own high-temperature materials like composite armor and bion compounds.",
      "altaDescription" : "Dense alien metal bar! Interesting, but we have our own ways of handling heat."
    },
    "lead" : {
      "longdescription" : "A dense block of lead. While not commonly used in alta technology, lead occasionally appears in radiation shielding for imported equipment.",
      "altaDescription" : "Heavy alien metal. Dense and practical, but not something we use much."
    },
