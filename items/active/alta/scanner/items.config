      "altaDescription" : "High-grade salvage! Contains useful rare materials for advanced projects~"
    },
    "salvagetier5" : {
      "longdescription" : "Elite tier 5 salvage with extremely valuable technology. Alta researchers carefully study these advanced components for insights into cutting-edge alien engineering.",
      "altaDescription" : "Elite-tier salvage! Fascinating advanced tech to analyze and learn from!"
    },
    "salvagetier6" : {
      "longdescription" : "Legendary tier 6 salvage containing the most advanced alien technology. Altas treat these as precious research materials, preserving them for detailed study.",
      "altaDescription" : "Legendary salvage! The pinnacle of alien tech - must study this carefully!"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // FOOD & BEVERAGES
    // ═══════════════════════════════════════════════════════════════════════════
    "cannedfood" : {
      "longdescription" : "Preserved food in metal cans for long-term storage. Altas study these preservation methods, though they prefer crystal containers and energy-based preservation.",
      "altaDescription" : "Canned food! Practical preservation, though I prefer crystal storage methods."
    },
    "cheese" : {
      "longdescription" : "Dairy cheese made from animal milk. As herbivores, altas don't consume cheese, but they study these fermentation processes with scientific interest.",
      "altaDescription" : "Animal product cheese. I can't eat it, but the fermentation chemistry is interesting!"
    },
    "chocolate" : {
      "longdescription" : "Sweet chocolate made from cacao plants. Being plant-based, altas can enjoy chocolate, and many appreciate its taste despite it not being traditional alta cuisine.",
      "altaDescription" : "Chocolate! Plant-based, so I can have it! Not traditional alta food, but tasty~"
    },
    "egg" : {
      "longdescription" : "Fresh eggs from various creatures. As herbivores, altas don't consume eggs, but they study them as biological specimens and food sources in alien cultures.",
      "altaDescription" : "Animal eggs. I don't eat these, but they're interesting biological specimens to study."
    },
    "milk" : {
      "longdescription" : "Fresh milk from mammals. Altas don't consume animal milk due to being herbivores, but they study dairy production in other species' cultures.",
      "altaDescription" : "Animal milk. Not for me since I'm herbivore, but fascinating from a biological standpoint!"
    },
    "oculemonade" : {
      "longdescription" : "Sweet lemonade drink made from eyeball-shaped fruit. Altas find the fruit interesting and the beverage refreshing, though unusual by alta taste standards.",
      "altaDescription" : "Oculemons are such weird fruit! But the lemonade is surprisingly refreshing~"
    },
    "reefcola" : {
      "longdescription" : "Popular carbonated cola beverage sold throughout the universe. Altas study these mass-produced drinks, comparing them to their own nia-based refreshment beverages.",
      "altaDescription" : "Universal soda brand! Different from our nia drinks, but the carbonation is fun."
    },
    "soda" : {
