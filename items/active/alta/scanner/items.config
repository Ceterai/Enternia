      "altaDescription" : "Why make them from glass? Why make anything from glass? Aliens, huh."
    },
    "glasscoffeemug" : {
      "longdescription" : "A coffee mug made of glass. While altas prefer crystal containers, they understand the appeal of glass for hot beverage consumption across alien cultures.",
      "altaDescription" : "Glass mug for hot drinks! Fragile though... why not use crystal instead?"
    },
    "syringe" : { "level" : 1,
      "longdescription" : "Syringes like these, although mostly made of glass, can often be made from crystals. Latter variant is a standard in alta culture.",
      "altaDescription" : "This is the standard base container for various enhancers."
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // MEDICAL & CONSUMABLES
    // ═══════════════════════════════════════════════════════════════════════════
    "bandage" : {
      "longdescription" : "Basic bandage for treating minor wounds. Altas have their own bandade varieties made from ayaka wood and silk, including bion-enhanced versions for alta physiology.",
      "altaDescription" : "Simple alien bandage! We have our own amiks - ayaka and bion ones work better~"
    },
    "medkit" : {
      "longdescription" : "Comprehensive medical kit that treats wounds and status effects. Alta medical technology focuses more on preventive shielders, but medkits are useful for emergencies.",
      "altaDescription" : "Full medical kit! Handy for emergencies when shielders aren't enough."
    },
    "nanowrap" : {
      "longdescription" : "Advanced nanowrap bandage with rapid healing technology. Alta researchers appreciate the nanotechnology, comparing it to their own bion-based healing approaches.",
      "altaDescription" : "Nanotech healing! Different approach from our bion methods, but impressive~"
    },
    "salve" : {
      "longdescription" : "Natural healing salve made from plant extracts. Altas appreciate plant-based medicines, having their own botanical remedy traditions.",
      "altaDescription" : "Plant-based healing! Natural remedies are always nice to see."
    },
    "redstim" : {
      "longdescription" : "Alien stim pack with powerful regeneration liquid. Altas have their own stim varieties (electric, ionic, plasma, hevikai) that work with alta physiology and energy systems.",
      "altaDescription" : "Alien regeneration stim! Different chemistry from our ionic and plasma stims."
    },
    "bluestim" : {
      "longdescription" : "Alien stim pack that enhances jumping ability. Alta researchers study these chemical enhancement approaches, comparing them to their own energy-based stim technology.",
      "altaDescription" : "Jump boost stim! We prefer energy-based enhancements, but interesting chemistry~"
    },
    "greenstim" : {
      "longdescription" : "Alien stim pack for enhanced running speed. Altas developed their own movement enhancement stims using ionic and plasma formulations instead of chemical compounds.",
      "altaDescription" : "Speed boost stim! Different approach from our ionic movement enhancements."
    },
    "orangestim" : {
      "longdescription" : "Alien stim pack that triggers aggressive enhancement. Alta researchers study these emotion-affecting compounds, though altas prefer balanced energy-based enhancements.",
      "altaDescription" : "Rage-inducing stim?! That seems... dangerous. I'd prefer something more... balanced?"
    },
    "yellowstim" : {
      "longdescription" : "Alien stim pack that makes users glow. Altas find this bioluminescent effect interesting, comparing it to their own yonnur (glow extract) technology.",
      "altaDescription" : "Glow stim! We use yonnur extracts for similar glowing effects~"
    },
    "grassremedy" : {
      "longdescription" : "Natural remedy made from plant elements. Alta herbalists appreciate these botanical healing traditions from other species.",
      "altaDescription" : "Plant-based medicine! Natural healing methods are always worth studying."
    },
    "bottledwater" : {
      "longdescription" : "Clean bottled water for hydration and minor healing. While universal, altas prefer crystal containers over glass bottles for storing liquids.",
      "altaDescription" : "Simple water in a glass bottle. Why not use a crystal container though?"
    },
    "bottledhealingwater" : {
      "longdescription" : "Water with incredible restorative properties. Alta researchers study these natural healing waters, comparing them to their own botanical remedy traditions.",
      "altaDescription" : "Amazing healing water! Natural restoration power is always fascinating~"
    },
    "antidote" : {
      "longdescription" : "General antidote protecting against poisons. Altas have their own netrima (antidote) variants like Hevikai Netrima for specific poisonous conditions.",
      "altaDescription" : "Universal poison antidote! We have our own netrimas for specific toxins."
    },
    "burnspray" : {
      "longdescription" : "Cooling spray for treating burns and fire damage. Alta medical researchers study these topical treatments, comparing them to their own ionic cooling remedies.",
      "altaDescription" : "Burn treatment spray! This chemical approach is interesting~"
    },
    "fungusstim" : {
      "longdescription" : "Medicinal stim derived from mushroom extracts that protects against poison. Alta researchers study these fungal-based remedies, finding them fascinating examples of natural antitoxins.",
      "altaDescription" : "Mushroom-based poison protection! Aric medicine has such interesting properties~"
    },
    "shroomremedy" : {
      "longdescription" : "Natural remedy made from medicinal mushrooms. Alta herbalists appreciate fungal medicine traditions, comparing them to their own aric (mushroom) research.",
      "altaDescription" : "Fungal remedy! Natural mushroom medicine is always worth studying for its unique properties."
    },
    "synthesisstim" : {
      "longdescription" : "Advanced synthetic stim that combines multiple enhancement effects. Alta researchers study these complex chemical formulations, comparing them to their own multi-energy stim technology.",
      "altaDescription" : "Multi-effect synthetic stim! Complex chemistry... we prefer combining different energy types though~"
    },
    "valentinechocolates" : {
      "longdescription" : "Special heart-shaped chocolates traditionally given as gifts. Altas celebrate Ava Day (their gift-giving tradition) instead of Valentine's Day, but appreciate the universal gesture of chocolate gifts.",
      "altaDescription" : "Valentine chocolates! Can't wait for Ava Day to gift it to someone~ And chocolate is plant-based, so I can enjoy it too!"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // FUEL & ENERGY RESOURCES
    // ═══════════════════════════════════════════════════════════════════════════
    "solidfuel" : {
      "longdescription" : "Crystalline erchius fuel for FTL travel. Altas recognize erchius as present on their moonlike planets (alterash, enterash) and use it for ship fuel.",
      "altaDescription" : "Erchius crystals! Essential for FTL travel, we have these on our planets too~"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // CLOTHING DYES
    // ═══════════════════════════════════════════════════════════════════════════
    "reddye" : {
      "alkey" : "mikous",
      "longdescription" : "Red clothing dye used across the universe. Altas appreciate red dye for accenting their garments, though they prefer their own altan and bion dye palettes.",
      "altaDescription" : "Red dye! Nice for accents, though I'm more used to omniblue and altan shades~"
    },
    "orangedye" : {
      "alkey" : "cirous",
      "longdescription" : "Orange clothing dye common in alien fashion. While not traditional alta colors, orange has its uses for warm, visible accents.",
      "altaDescription" : "Orange! Warm and bright. Not typical for altas, but I like it for standing out~"
    },
    "yellowdye" : {
      "alkey" : "farous",
      "longdescription" : "Yellow clothing dye popular across species. Altas appreciate yellow's cheerful brightness, using it in casual clothing.",
      "altaDescription" : "Yellow dye! Cheerful and sunny, nice for casual outfits!"
    },
    "greendye" : {
      "alkey" : "yezous",
      "longdescription" : "Green clothing dye found throughout the universe. Altas favor green for its connection to nature and plant life.",
      "altaDescription" : "Green! Reminds me of alterash havens and yaara groves~"
    },
    "bluedye" : {
      "alkey" : "altous",
      "longdescription" : "Blue clothing dye, very popular in alta culture. Blue is the dominant alta color, reflected in their omniblue palette and plasma energy.",
      "altaDescription" : "Blue! My favorite color! Though the altan dye has better shades~"
    },
    "purpledye" : {
      "alkey" : "entous",
      "longdescription" : "Purple clothing dye appreciated across species. Altas connect purple with enternia (ionic/dream energy) and enterash planets.",
      "altaDescription" : "Purple! Reminds me of enternia and ionic energy~"
    },
    "pinkdye" : {
      "alkey" : "mikous",
      "longdescription" : "Pink clothing dye used in decorative fashion. Altas associate pink with stardust energy, the combination of all three alta energies.",
      "altaDescription" : "Pink! Stardust color! The combination of all three energies, so special~"
    },
    "browndye" : {
      "alkey" : "vinkumous",
      "longdescription" : "Brown clothing dye common in practical garments. While functional, brown is rarely used in alta fashion which favors brighter energy-themed colors.",
      "altaDescription" : "Brown. Practical, I guess... but I'm used to brighter colors! Not really my style."
    },
    "blackdye" : {
      "alkey" : "essous",
      "longdescription" : "Black clothing dye for dark garments. Altas use black for bion and EDS armor coloring, giving a sleek professional appearance.",
      "altaDescription" : "Black! Perfect for bion armor and EDS equipment - sleek and professional."
    },
    "whitedye" : {
      "alkey" : "sitous",
      "longdescription" : "White clothing dye for bright clean garments. Altas favor white for its purity and how it showcases their altan metallic sheen.",
      "altaDescription" : "White! Clean and pure, shows off altan shine beautifully~"
    },
    "greydye" : {
      "alkey" : "avessous",
      "longdescription" : "Grey clothing dye for neutral tones. Altas use grey for titanium-colored equipment and neutral professional wear.",
      "altaDescription" : "Grey. Good for titanium equipment, though not the most exciting color for me."
    },
    "dyeremover" : {
      "alkey" : "eseous",
      "longdescription" : "Chemical solution that removes dye and restores original colors. Altas appreciate this restoration technology for preserving original altan and bion shades.",
      "altaDescription" : "Dye remover! Useful for getting back to original altan colors~"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // UPGRADE COMPONENTS & MODULES
    // ═══════════════════════════════════════════════════════════════════════════
    "manipulatormodule" : {
      "longdescription" : "Advanced module for upgrading matter manipulators. Alta engineers study these universal upgrade systems, having developed their own modular technology designs.",
      "altaDescription" : "Matter manipulator upgrade! Protectorate's modular design is smart - easy to swap and improve."
    },
    "upgrademodule" : {
      "longdescription" : "Universal modules for upgrading ships and equipment. Altas use similar modular upgrade systems in their own technology, emphasizing compatibility and adaptability.",
      "altaDescription" : "Universal upgrade module! Modular design is smart - easy to swap and improve."
    },
    "techcard" : {
      "longdescription" : "Blank tech cards for developing enhanced technologies. Alta engineers use similar datamass-based technology development systems for their own tech upgrades.",
      "altaDescription" : "Tech development card! We use datamasses for similar purposes~"
    },
    "autochip" : {
      "longdescription" : "Vehicle repair component used across the universe. Alta mechanics study these standardized repair systems, comparing them to their own modular vehicle technology.",
      "altaDescription" : "Vehicle repair chip! Universal standards make cross-galactical travel easier and more convenient."
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // CURRENCY & TOKENS
    // ═══════════════════════════════════════════════════════════════════════════
    "dubloon" : {
      "longdescription" : "Penguin mercenary currency accepted at the Beakeasy Bar. Altas find the penguin economy fascinating to study from a sociological perspective.",
      "altaDescription" : "Penguin currency! Their mercenary economy is quite different from ours."
    },
    "peacecredit" : {
      "longdescription" : "Terrene Protectorate reward token. Alta diplomats recognize peace credits as part of the Protectorate's recognition system for peacekeeping efforts.",
      "altaDescription" : "Protectorate currency! Recognition tokens for peacekeeping work."
    },
    "voxel1k" : {
      "longdescription" : "Compressed pixel currency stored efficiently. Altas appreciate the practical approach to currency storage, similar to their own compact energy cell designs.",
      "altaDescription" : "Compressed pixels! Smart way to carry large amounts without bulk~"
    },
    "voxel2k" : {
      "longdescription" : "2000 pixels compressed into compact form. Alta economists study these universal currency compression systems across different species.",
      "altaDescription" : "Even more compressed pixels! Efficient storage is always appreciated."
    },
    "voxel5k" : {
      "longdescription" : "5000 pixels in compressed voxel form. Altas find these high-density currency units practical for large transactions.",
      "altaDescription" : "High-value voxel! Convenient for bigger purchases and trades."
    },
    "voxel10k" : {
      "longdescription" : "10000 pixels compressed to maximum density. Alta traders use these for major transactions across the universe.",
      "altaDescription" : "Maximum compression voxel! Perfect for significant transactions~"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // QUEST ITEMS & ARTIFACTS
    // ═══════════════════════════════════════════════════════════════════════════
    "vaultkey" : {
      "longdescription" : "Mysterious key to ancient forgotten places. Alta archaeologists study these artifacts, fascinated by the lost civilizations they might unlock.",
      "altaDescription" : "Ancient vault key! I wonder what forgotten secrets it guards?"
    },
    "translator1" : {
      "longdescription" : "Left half of an ancient rune translation wheel. Alta linguists find these ancient translation devices fascinating, comparing them to their own alkey language systems.",
      "altaDescription" : "Ancient translation wheel! Left half. Wonder how their runes compare to alkey~"
    },
    "translator2" : {
      "longdescription" : "Right half of an ancient rune translation wheel. Together with its pair, it unlocks ancient linguistic knowledge.",
      "altaDescription" : "Ancient translation wheel! Right half. These ancient language tools are so interesting!"
    },
    "ancientalphabet" : {
      "longdescription" : "A guidebook for translating ancient runes. Alta linguists treasure these as historical keys to understanding extinct civilizations.",
      "altaDescription" : "Ancient rune translation guide! Fascinating to see how other species preserved knowledge before energy-based systems~"
    },
    "protectorateflyer" : {
      "longdescription" : "Recruitment flyer from the Terrene Protectorate. Alta historians preserve these as artifacts from the Protectorate era, studying their diplomatic outreach methods.",
      "altaDescription" : "Protectorate recruitment flyer! Historical artifact from before the Ruin. We preserve these~"
    },
    "secretnote" : {
      "longdescription" : "A secret note with hidden information. Alta cryptographers find encrypted messages fascinating, comparing them to their own secure datamass encryption.",
      "altaDescription" : "Secret note! I love puzzles and hidden messages. Wonder what encryption method they used?"
    },
    "winningticket" : {
      "longdescription" : "A winning lottery ticket worth celebrating. Altas study probability-based games across cultures, finding them interesting exercises in mathematics and luck.",
      "altaDescription" : "Winning ticket! Probability games are fascinating. The math behind random chance is beautiful~"
    },
    "parcel" : {
      "longdescription" : "Someone's parcel wrapped with ribbon. Alta mail carriers recognize the universal appeal of well-packaged deliveries.",
      "altaDescription" : "Nicely wrapped parcel! I hope whoever it's for receives it safely~"
    },
    "mysteriousashes" : {
      "longdescription" : "Mysterious ashes from something burned. Alta researchers approach such enigmatic remains with scientific curiosity, seeking to identify their origin.",
      "altaDescription" : "I wonder what this used to be? The composition is unusual..."
    },
    "mysterioustrashbag" : {
      "longdescription" : "A suspicious trash bag with unknown contents. Altas prefer proper waste management and recycling systems over mysterious disposal methods.",
      "altaDescription" : "Trash?! Why not use proper recycling? What could be hidden in here?.."
    },
    "rottenfood" : {
      "longdescription" : "Spoiled food that's no longer edible. Alta food preservation focuses on energy-based storage and crystal containers to prevent this.",
      "altaDescription" : "That's just... unfortunate..."
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // DOCUMENTS & CULTURAL ITEMS
    // ═══════════════════════════════════════════════════════════════════════════
    "soggypaper" : {
      "longdescription" : "Water-damaged paper with barely legible text. Alta archivists prefer crystal data storage specifically to avoid this kind of degradation.",
      "altaDescription" : "Soggy paper! This is exactly why we prefer datamasses and crystal storage. So fragile!"
    },
    "sheetmusic" : {
      "longdescription" : "Musical sheet notation from various cultures. Altas study alien musical traditions, comparing different species' approaches to sound and rhythm.",
      "altaDescription" : "Sheet music! Musical notation is universal language. I'd love to hear this performed~"
    },
    "comedyscript" : {
      "longdescription" : "A script for a comedy performance. Altas find alien humor fascinating to study, noting cultural differences in what different species find amusing.",
      "altaDescription" : "Comedy script! Alien humor is so interesting to analyze. Wonder if they'd laugh at our jokes?"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // SPECIAL & MISCELLANEOUS
    // ═══════════════════════════════════════════════════════════════════════════
    "snowflake" : {
      "alkey" : "sona",
      "longdescription" : "This is what most of the snow in the world is made from.",
      "altaDescription" : "Oh wow, it's so tiny, yet so... majestic!"
    },
    "coralfragment" : {
      "longdescription" : "Ember coral fragments that radiate pleasant warmth. Altas study these warm coral formations, comparing them to their own heated technology.",
      "altaDescription" : "So warm and cozy! Natural heat generation is always fascinating to study."
    },
    "gnome" : {
      "longdescription" : "It's a gnome. Altas find these decorative figures culturally fascinating, studying the alien traditions and folklore surrounding garden ornaments.",
      "altaDescription" : "Little garden gnome! I learned these are traditional decorations for some species."
    },
    "holidayspirit" : {
      "longdescription" : "The essence of the holiday season in its purest form. Altas study this emotional energy manifestation, finding it related to their own stardust and memory energy concepts.",
      "altaDescription" : "Pure holiday energy! It's like concentrated joy and celebration in material form!"
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TECHNOLOGY & ELECTRONICS
    // ═══════════════════════════════════════════════════════════════════════════
    "autodrive" : {
      "longdescription" : "Advanced autodrive component for automated ship systems. Alta engineers study these navigation technologies, comparing them to their own AI-assisted flight systems.",
      "altaDescription" : "Ship autodrive! Automated navigation is convenient, though I prefer manual controls~"
    },
    "battery" : { "level" : 3,
      "longdescription" : "Standard chemical batteries used across the galaxy for powering equipment. Altas study these alien power sources, though they developed their own energy cell and phospholion core technology instead.",
      "altaDescription" : "Alien battery technology! Interesting design, but we prefer energy cells and phospholion."
    },
    "smallbattery" : { "level" : 1,
      "longdescription" : "A small AA battery common in alien electronics. Alta researchers find these compact power sources fascinating, comparing them to their own miniaturized energy solutions.",
      "altaDescription" : "Tiny alien battery! We have our own versions, but this is a neat compact design~"
    },
    "processor" : { "level" : 5,
      "longdescription" : "A very powerful processor used in alien computing systems. Altas study these silicon-based processors, having developed their own crystal-based computing architecture with datamasses and calar technology.",
      "altaDescription" : "Powerful alien processor! We usually build ours with crystals instead of silicon though."
    },
    "siliconboard" : { "level" : 2,
      "longdescription" : "Silicon-based circuit boards found throughout alien technology. Altas developed crystal-based calar electronics instead, finding crystals more abundant on alterash and more efficient for their needs.",
      "altaDescription" : "Silicon circuits! We use calotronics with crystals - much prettier and more efficient~"
    },
    "wire" : { "level" : 1,
      "longdescription" : "A spool of copper wire used in alien electrical systems. Altas have their own lyar (wire) technology made from native materials, though they study alien wiring approaches.",
      "altaDescription" : "Copper wire from alien tech! We make our own lyar and izolyar instead."
    },
    "laserdiode" : { "level" : 2,
      "longdescription" : "A laser diode component from alien optical technology. Alta researchers study these laser components, having developed their own plasma and crystal-based optical systems.",
      "altaDescription" : "Alien laser component! Interesting design, different from our plasma technology~"
    },
    "lightbulb3" : { "level" : 1,
      "longdescription" : "A standard lightbulb used in alien technology. Altas find these electrical lighting solutions interesting, having developed their own bioluminescent and crystal-based illumination instead.",
      "altaDescription" : "Alien lightbulb! We prefer glowing crystals, yonnur, and bioluminescence though."
    },
    "bolt" : { "level" : 1,
      "longdescription" : "A small metal bolt used in alien mechanical construction. Alta engineers study these fastening methods, though their own technology uses different assembly approaches with titanium and altan.",
      "altaDescription" : "Alien fastener! We have our own assembly methods, but this is neat to study."
    },
    "cog" : { "level" : 1,
      "longdescription" : "A copper cog from alien mechanical systems. Altas find these mechanical components fascinating to study, having developed their own gear systems using native metals like titanium and altan.",
      "altaDescription" : "Copper gear from alien machinery! We make ours with titanium and altan instead~"
    },
    "screws" : { "level" : 1,
      "longdescription" : "Metal screws common in alien construction. Alta researchers study these universal fasteners, comparing them to their own modular assembly techniques.",
      "altaDescription" : "Alien screws! Universal design - everyone needs to hold things together somehow."
    },
    "hinge" : { "level" : 1,
      "longdescription" : "An iron hinge from alien architecture. Altas study these moving joint designs, having developed their own hinge systems using titanium and altan for better durability.",
      "altaDescription" : "Iron hinge from alien buildings! We use titanium hinges - they last much longer."
    },
    "robotarms" : { "level" : 3,
      "longdescription" : "Strong robot arms from alien robotics. Alta engineers study these mechanical manipulators, comparing them to their own drone, android, and industrial robot designs.",
      "altaDescription" : "Alien robot arms! Different design from our drones and androids, but similar purpose~"
    },
    "robotchest" : { "level" : 3,
      "longdescription" : "A robot torso unit from alien robotics. Altas study these structural designs, having developed their own android and security bot chassis with bion compound reinforcement.",
      "altaDescription" : "Alien robot torso! We build ours differently, with better materials and bion tech."
    },
    "robothead" : { "level" : 3,
      "longdescription" : "A robot head with integrated living brain from alien biotech. Alta researchers find this approach ethically concerning, preferring pure AI consciousness in their own android development.",
      "altaDescription" : "Robot with a living brain?! That's... really concerning. We use pure AI instead."
    },
    "robotlegs" : { "level" : 3,
      "longdescription" : "Robot legs from alien robotics. Alta engineers study these mobility systems, comparing them to their own walker units, drones, and android locomotion designs.",
      "altaDescription" : "Alien robot legs! Our walkers and androids move differently, but same basic idea."
    },

