    "grassMod" : [ "grass" ], "grassModDensity" : 0.9,  // Dense green grass on floors of caves
    "ceilingGrassMod" : [ "undergrowth" ], "ceilingGrassModDensity" : 0.3,  // Some small brown undergrowth on ceilings of caves
