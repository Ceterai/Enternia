{
  "name" : "ct_alterash_enchanted",
  "friendlyName" : "Enchanted Meadows",
  "description" : "^#8080f0;Vionostera^reset;, or enchanted land, is an almost magical place full of mystical things, hence the name.  \nBlue fields of dense grass with pink tops of ^#8080f0;blossoming ayakas^reset;, ^#8080f0;enchanted orbs^reset; and rare ^#8080f0;beakseed^reset; bushes showing above the surface.  \nUnder the ground there are glowing ^#8080f0;enchanted bushes^reset;, lighting up the caves with pink bioluminescence.\n\nThis place looks almost magical, even though this kind of view is somewhat common for the ionized temperate climate.  \nAt its core, this place is an anomaly, caused by high concentration of conflicting energies.\n\nA much rarer variation of this biome is called ^#f080f0;Invertia^reset; - the main difference is that the whole palette turns upside-down, and greener grass can occur amid usual enchanted purple.",
  "longdescription" : "\nMore information about the Enchantment phenomenon can be discovered with the ^#8080f0;Enchanted Datamass^reset;.",
  "icon" : "/items/active/alta/loot/biome/ct_enchanted_loot.png",
  "mainBlock" : "moonstone",
  "subBlocks" : [ "moonrock", "cloudblock" ],
  "ores" : "prismore",  // Main (and only) ore type found in this biome inside blocks are Prism Shards

  "hueShiftOptions" : [0],  // No hue shift for grass or blocks (hue shifts for trees and bushes are defined in placeables)
  "parallax" : "/parallax/surface/ct_alterash_garden.parallax",  // Biome background - for now uses regular alterash garden scenery

  "spawnProfile" : {
    "monsterParameters" : { "colors" : "ocean", "statusSettings" : { "stats" : { "electricStatusImmunity" : { "baseValue" : 1.0 } } } },  // Randomly generated creatures will have "ocean" colors (not applicable as no random creatures spawn here) and all spawned creatures are immune to electric status effects
    "groups" : [
      // Ground hostile creatures - /spawntypes/my_enternia/creatures.spawntypes
      { "select" : 1, "pool" : [ [ 1, "ct_astral_narfin_spawn" ] ] },  // Astral narfins, spawn both on surface and subsurface
      { "select" : 1, "pool" : [ [ 1, "ct_alterash_night_spawn" ] ] },  // Spawn nightmare orbides and anglures on the surface at night
      // Bugs - /spawntypes/my_enternia/bugs.spawntypes
      { "select" : 1, "pool" : [ [ 1, "ct_vio_zych_spawn" ] ] },  // Vio Zyches, spawn both on surface and subsurface but only during the day
      // Critters - /spawntypes/my_enternia/critter.spawntypes
      { "select" : 3, "pool" : [ [ 1, "ct_miazmur_spawn"], [ 0.15, "prismelementalcritter"], [ 0.15, "bioluminfireflyspawner"] ] }  // Miamzurs on surface at night, prism elementals on surface during day, and bioluminescent fireflies on surface at night
    ]
  },

  "ambientNoises" : {
    "day" : { "tracks" : [ "/sfx/environmental/forest_day.ogg", "/sfx/environmental/forest_day2.ogg" ] },
    "night" : { "tracks" : [ "/sfx/environmental/forest_night.ogg", "/sfx/environmental/forest_night2.ogg" ] }
  },
  "musicTrack" : {
    "day" : { "tracks" : [ "/music/epsilon-indi.ogg", "/music/hymn-to-the-stars.ogg", "/music/procyon.ogg", "/music/stellarformation.ogg", "/music/vast-immortal-suns.ogg", "/music/atlas.ogg", "/music/blue-straggler.ogg", "/music/cygnus-x1.ogg", "/music/europa.ogg", "/music/haiku.ogg", "/music/m54.ogg", "/music/on-the-beach-at-night.ogg" ] },
    "night" : { "tracks" : [ "/sfx/environmental/tundra_night.ogg", "/music/jupiter.ogg", "/music/arctic-constellation1.ogg", "/music/arctic-constellation2.ogg", "/music/mercury.ogg", "/music/mira.ogg", "/music/procyon.ogg", "/music/tranquility-base.ogg", "/music/psyche.ogg", "/music/accretion-disc.ogg", "/music/cygnus-x1.ogg", "/music/eridanus-supervoid.ogg", "/music/horsehead-nebula.ogg", "/music/large-magellanic-cloud.ogg", "/music/m54.ogg", "/music/nomads.ogg", "/music/on-the-beach-at-night.ogg" ] }
  },

  "surfacePlaceables" : {
    "friendlyName" : "Enchanted Surface",
    "description" : "The surface of vionostera is full of colourful grass and mystical plants. That said, since originally it was a usual alterash garden or forest, you can see enchanted ayakas from time to time, as well as some other familiar sites.\n\nStill, vionia has changed this place a lot, making it look magical - with purple-magenta colours dominating the scenery.\n\nThe main crop of the surface is beakseed, more common on avian-inhabited worlds, but thriving here as well.\n\nFrom time to time you can find an enchanted orb - an organic vionic formation holding some enchanted loot. Critters of the surface, on the other hand, are not organic - these tiny vibrant magenta-purple elementals are called miazmurs, and they glow in the dark.\n\nFinally, the enchanted surface is home to little flying bugs called vio zyches, which are attracted to energy-filled plants and flowers and are also viona-colored.\n\nBecause of viona nature, the surface is also full of energetic anomalies and anomalous structures, usually floating in the air.",
    "grassMod" : [ "colourfulgrass" ], "grassModDensity" : 0.9,  // Dense blue-pink grass
    "ceilingGrassMod" : [ "undergrowth" ], "ceilingGrassModDensity" : 0.5,  // Some small brown undergrowth on ceilings of overhangs
    "items" : [
      // Tech
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:surfaceCapsules", "type" : "object",
        "objectSets" : [ { "pool" : [ [0.35, "capsulesmall" ], [0.35, "capsulemed" ], [0.35, "capsulebig" ] ], "parameters" : { } } ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:overgroundChests", "type" : "treasureBox",
        "treasureBoxSets" : [ "ct_alta_pod_tier1" ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:overgroundChests", "type" : "object",
        "objectSets" : [ { "pool" : [ [1, "statuspod" ] ], "parameters" : { } } ]
      },
      // Dungeons
      {
        "mode" : "floor", "priority" : 2, "variants" : 2, "distribution" : "/biomes/distributions.config:tiyDist", "type" : "microdungeon",
        "microdungeons" : ["oasis", "blank", "none" ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:mainBiomeEncounterDungeon", "type" : "microdungeon",
        "microdungeons" : [ "encounterdungeons" ]
        // "microdungeons" : [ "ct_faradea_camp", "ct_alta_merchant_stop", "ct_alta_camp", "blank", "none" ]
      },
      // Growth
      {
        "mode" : "floor", "priority" : 0.5, "variants" : 4, "distribution" : "/biomes/distributions.config:scatteredSmall", "type" : "grass",
        "grasses" : [ "grass", "testflower", "testflower2", "testflower3", "testflower4", "testflower5", "testflower6", "testflower7" ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:scatteredSmall", "type" : "bush",
        "bushes" : [ { "name" : "ct_valley_bush", "baseHueShiftMax" : 0, "modHueShiftMax" : 0, "baseHueShiftMin" : 0, "modHueShiftMin" : 0 } ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:scatteredSmall", "type" : "bush",
        "bushes" : [ { "name" : "ct_valley_bush", "baseHueShiftMax" : -105, "modHueShiftMax" : 0, "baseHueShiftMin" : -105, "modHueShiftMin" : 0 } ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:denseLarge", "type" : "tree",
        "treeFoliageHueShiftMax" : 0, "treeFoliageHueShiftMin" : 0, "treeStemHueShiftMax" : 15,
        "treeStemList" : [ "ct_ayaka_blossom_stem" ], "treeFoliageList" : [ "ct_ayaka_blossom_leaves" ]
      },
      {
        "mode" : "floor", "priority" : 2, "variants" : 1, "distribution" : "/biomes/distributions.config:denseSurfaceCrops", "type" : "object",
        "objectSets" : [ { "pool" : [ [1, "wildbeakseedseed" ] ], "parameters" : { "startingStage" : 2 } } ]
      },
      // Other
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:minibiomeChests", "type" : "treasureBox",
        "treasureBoxSets" : [ "ct_enchanted_chest" ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 1, "distribution" : "/biomes/distributions.config:minibiomeChests", "type" : "treasureBox",
        "treasureBoxSets" : [ "ct_enchanted_chest" ]
      },
      {
        "mode" : "floor", "priority" : 1, "variants" : 3, "distribution" : "/biomes/distributions.config:scatteredSmall", "type" : "object",
        "objectSets" : [ { "pool" : [ [0.35, "prismrock1" ], [0.35, "prismrock2" ], [0.35, "prismrock3" ] ], "parameters" : { } } ]
      }
    ]
  },

